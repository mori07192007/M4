import pygame
from pygame import Rect


pygame.init()

W, H = 960, 540
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("Platformer (LEFT/RIGHT move, UP jump) - score & result")
clock = pygame.time.Clock()

# --- 定数（調整しやすい） ---
G = 2400.0
MOVE_ACC = 6200.0
AIR_ACC = 4200.0
MAX_SPEED = 420.0
FRICTION = 7200.0
JUMP_V = 860.0

COYOTE = 0.08
JUMP_BUFFER = 0.10

# 敵
ENEMY_SPEED = 110.0
STOMP_BOUNCE_V = 520.0

# スコア
STOMP_BASE = 100     # 1体目
GOAL_SCORE = 1000
COMBO_RESET_TIME = 1.2  # 最後に踏んでからこの秒数を超えるとコンボリセット

# --- レベル（床/足場） ---
solids = [
    Rect(-2000, 460, 900, 200),
    Rect(-900,  460, 700, 200),
    Rect(50,    460, 800, 200),
    Rect(950,   460, 900, 200),

    Rect(-650, 360, 180, 24),
    Rect(-350, 300, 180, 24),
    Rect(-50,  340, 180, 24),
    Rect(260,  280, 240, 24),
    Rect(620,  340, 180, 24),
    Rect(1120, 320, 240, 24),

    Rect(1500, 390, 220, 70),
]

spikes = [
    Rect(780, 440, 120, 20),
]

# ゴール（旗っぽいもの）
goal = Rect(1700, 250, 26, 210)

# --- プレイヤ ---
player = Rect(-750, 200, 32, 42)
vx, vy = 0.0, 0.0
on_ground = False
coyote_timer = 0.0
jumpbuf_timer = 0.0

camera_x = 0.0

# クリア状態
cleared = False

# --- 敵（踏める） ---
enemies = []


def spawn_enemies():
    global enemies
    enemies = [
        {"rect": Rect(-520, 330, 34, 30), "dir":  1, "alive": True},
        {"rect": Rect(350, 250, 34, 30),  "dir": -1, "alive": True},
        {"rect": Rect(1250, 290, 34, 30), "dir":  1, "alive": True},
    ]


# --- スコア状態 ---
score_total = 0
score_goal = 0
score_stomp = 0
stomp_count = 0
combo_index = 0
combo_timer = 0.0
clear_time = 0.0


def reset():
    global vx, vy, on_ground, coyote_timer, jumpbuf_timer, camera_x, cleared
    global score_total, score_goal, score_stomp, stomp_count, combo_index, combo_timer, clear_time
    global facing_right

    player.x, player.y = -750, 200
    vx, vy = 0.0, 0.0
    on_ground = False
    coyote_timer = 0.0
    jumpbuf_timer = 0.0
    camera_x = player.x - W * 0.35
    cleared = False
    spawn_enemies()

    facing_right = True

    score_total = 0
    score_goal = 0
    score_stomp = 0
    stomp_count = 0
    combo_index = 0
    combo_timer = 0.0
    clear_time = 0.0


def clamp(x, a, b):
    return a if x < a else b if x > b else x


def move_and_collide_player(dt):
    """プレイヤの軸分離衝突解決"""
    global vx, vy, on_ground
    on_ground = False

    # X
    player.x += int(vx * dt)
    for s in solids:
        if player.colliderect(s):
            if vx > 0:
                player.right = s.left
            elif vx < 0:
                player.left = s.right
            vx = 0.0

    # Y
    player.y += int(vy * dt)
    for s in solids:
        if player.colliderect(s):
            if vy > 0:
                player.bottom = s.top
                vy = 0.0
                on_ground = True
            elif vy < 0:
                player.top = s.bottom
                vy = 0.0


def move_enemy_and_collide(e, dt):
    """敵は重力なし・床上を左右移動。壁や端で反転。"""
    r: Rect = e["rect"]
    dx = e["dir"] * ENEMY_SPEED * dt

    r.x += int(dx)

    hit_wall = False
    for s in solids:
        if r.colliderect(s):
            hit_wall = True
            if dx > 0:
                r.right = s.left
            else:
                r.left = s.right
            break

    # 前方に床が無ければ反転
    front_x = r.right + 2 if e["dir"] > 0 else r.left - 2
    foot_probe = Rect(front_x, r.bottom + 1, 2, 4)
    has_floor_ahead = any(foot_probe.colliderect(s) for s in solids)

    if hit_wall or (not has_floor_ahead):
        e["dir"] *= -1


def is_stomp(player_rect: Rect, enemy_rect: Rect, vy_value: float):
    """簡易踏み判定（落下中 + 足元が敵上面付近）"""
    if vy_value <= 0:
        return False
    return (player_rect.bottom - enemy_rect.top) <= 14


def calc_stomp_points(combo_i: int) -> int:
    """連続踏み倍率: +100, +200, +400,..."""
    # combo_i: 0 => 100
    return STOMP_BASE * (2 ** combo_i)


reset()

running = True
font = pygame.font.SysFont(None, 26)
font_big = pygame.font.SysFont(None, 44)

# --- プレイヤ画像 ---
# main.py と同じフォルダに以下を置いてください（透過PNG推奨・同サイズ推奨）
#   player_idle.png  : 停止時
#   player_run.png   : 移動時
#   player_jump.png  : ジャンプ/空中時
try:
    img_idle = pygame.image.load("player_idle.png").convert_alpha()
    img_run = pygame.image.load("player_run.png").convert_alpha()
    img_jump = pygame.image.load("player_jump.png").convert_alpha()
except Exception as ex:
    raise SystemExit(
        "player_idle.png / player_run.png / player_jump.png が読み込めません。\n"
        "main.py と同じフォルダに3つのPNGを置いてから起動してください。\n"
        f"詳細: {ex}"
    )

# プレイヤ当たり判定サイズに合わせる（画像が大きくても縮小されます）
img_idle = pygame.transform.smoothscale(img_idle, (player.w, player.h))
img_run = pygame.transform.smoothscale(img_run, (player.w, player.h))
img_jump = pygame.transform.smoothscale(img_jump, (player.w, player.h))

# 方向（右向き=True / 左向き=False）
facing_right = True

while running:
    dt = min(0.02, clock.tick(60) / 1000.0)

    # NOTE: facing_right はループ内で更新するので global 宣言が必要
    # （このファイルは関数ではないので、ここでは不要）

    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    if keys[pygame.K_r]:
        reset()

    if not cleared:
        clear_time += dt

        left = keys[pygame.K_LEFT]
        right = keys[pygame.K_RIGHT]
        jump = keys[pygame.K_UP]

        # 向き更新（入力があるときだけ更新）
        if left and not right:
            facing_right = False
        elif right and not left:
            facing_right = True

        # コンボタイマー（一定時間踏まないとリセット）
        if combo_index > 0:
            combo_timer += dt
            if combo_timer > COMBO_RESET_TIME:
                combo_index = 0
                combo_timer = 0.0

        # ジャンプバッファ
        if jump:
            jumpbuf_timer = JUMP_BUFFER
        else:
            jumpbuf_timer = max(0.0, jumpbuf_timer - dt)

        # コヨーテ
        if on_ground:
            coyote_timer = COYOTE
        else:
            coyote_timer = max(0.0, coyote_timer - dt)

        # 左右加速
        ax = MOVE_ACC if on_ground else AIR_ACC
        if left and not right:
            vx -= ax * dt
        if right and not left:
            vx += ax * dt

        # 摩擦（地上＆入力なし）
        if on_ground and not left and not right:
            if abs(vx) <= FRICTION * dt:
                vx = 0.0
            else:
                vx -= (FRICTION * dt) * (1 if vx > 0 else -1)

        vx = clamp(vx, -MAX_SPEED, MAX_SPEED)

        # 重力
        vy += G * dt

        # ジャンプ成立
        if jumpbuf_timer > 0.0 and coyote_timer > 0.0:
            vy = -JUMP_V
            jumpbuf_timer = 0.0
            coyote_timer = 0.0
            on_ground = False

        # 敵更新
        for en in enemies:
            if en["alive"]:
                move_enemy_and_collide(en, dt)

        # プレイヤ移動
        move_and_collide_player(dt)

        # 落下死
        if player.y > 1200:
            reset()

        # トゲ
        for sp in spikes:
            if player.colliderect(sp):
                reset()

        # 敵当たり判定（踏み / 接触死）
        for en in enemies:
            if not en["alive"]:
                continue
            er = en["rect"]
            if player.colliderect(er):
                if is_stomp(player, er, vy):
                    en["alive"] = False

                    # スコア加算（倍率）
                    points = calc_stomp_points(combo_index)
                    score_total += points
                    score_stomp += points
                    stomp_count += 1
                    combo_index += 1
                    combo_timer = 0.0

                    # 反動
                    player.bottom = er.top
                    vy = -STOMP_BOUNCE_V
                else:
                    reset()
                    break

        # ゴール
        if player.colliderect(goal):
            cleared = True
            score_goal = GOAL_SCORE
            score_total += score_goal
            vx = 0.0
            vy = 0.0

        # カメラ
        target = player.x - W * 0.35
        camera_x += (target - camera_x) * min(1.0, 8.0 * dt)

    # --- 描画 ---
    screen.fill((27, 59, 122))
    pygame.draw.rect(screen, (30, 140, 200), Rect(0, 0, W, H))

    # 足場
    for s in solids:
        sx = s.x - int(camera_x)
        pygame.draw.rect(screen, (91, 58, 29), Rect(sx, s.y, s.w, s.h))
        pygame.draw.rect(screen, (122, 75, 34), Rect(sx, s.y, s.w, 6))

    # トゲ
    for sp in spikes:
        sx = sp.x - int(camera_x)
        pygame.draw.rect(screen, (196, 59, 59), Rect(sx, sp.y, sp.w, sp.h))

    # ゴール旗
    gx = goal.x - int(camera_x)
    pygame.draw.rect(screen, (230, 230, 230), Rect(gx, goal.y, 6, goal.h))
    pygame.draw.rect(screen, (60, 240, 120), Rect(gx + 6, goal.y + 20, 40, 24))

    # 敵
    for en in enemies:
        if not en["alive"]:
            continue
        r = en["rect"]
        ex = r.x - int(camera_x)
        pygame.draw.rect(screen, (210, 120, 50), Rect(ex, r.y, r.w, r.h))
        pygame.draw.rect(screen, (15, 15, 15), Rect(ex + 8, r.y + 10, 4, 4))
        pygame.draw.rect(screen, (15, 15, 15), Rect(ex + 20, r.y + 10, 4, 4))

    # プレイヤ
    px = player.x - int(camera_x)

    # 状態に応じて画像を切り替え
    #  - 空中: jump
    #  - 地上で速度あり: run
    #  - それ以外: idle
    if cleared:
        # クリア後は停止絵
        img = img_idle
    else:
        in_air = not on_ground
        if in_air:
            img = img_jump
        else:
            if abs(vx) > 40.0:
                img = img_run
            else:
                img = img_idle

    # 左向きなら左右反転
    if facing_right:
        draw_img = img
    else:
        draw_img = pygame.transform.flip(img, True, False)

    screen.blit(draw_img, (px, player.y))

    # HUD（左上）
    hud1 = font.render("Move: LEFT/RIGHT   Jump: UP   R: reset", True, (255, 255, 255))
    hud2 = font.render(f"SCORE: {score_total}   COMBO: x{(2**combo_index) if combo_index>0 else 1}", True, (255, 255, 255))
    screen.blit(hud1, (12, 10))
    screen.blit(hud2, (12, 34))

    # クリア時：結果発表
    if cleared:
        overlay = pygame.Surface((W, H), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        screen.blit(overlay, (0, 0))

        title = font_big.render("RESULT", True, (255, 255, 255))
        screen.blit(title, (W // 2 - title.get_width() // 2, 90))

        lines = [
            f"TIME: {clear_time:0.2f}s",
            f"STOMPS: {stomp_count}  (points: {score_stomp})",
            f"GOAL BONUS: {score_goal}",
            "------------------------",
            f"TOTAL SCORE: {score_total}",
            "",
            "Press R to restart",
        ]

        y = 160
        for line in lines:
            t = font.render(line, True, (255, 255, 255))
            screen.blit(t, (W // 2 - t.get_width() // 2, y))
            y += 30

    pygame.display.flip()

pygame.quit()
