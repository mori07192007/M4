import pygame
from pygame import Rect

pygame.init()

W, H = 960, 540
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("Platformer (LEFT/RIGHT move, UP jump) - flat stage & time bonus")
clock = pygame.time.Clock()

# --- 定数（調整しやすい） ---
G = 2400.0
MOVE_ACC = 6200.0
AIR_ACC = 4200.0
MAX_SPEED = 420.0
FRICTION = 7200.0
JUMP_V = 860.0

COYOTE = 0.08
JUMP_BUFFER = 0.10

# --- レベル（床/足場） ---
solids = [
    # 平らな床だけ（穴・足場なし）
    Rect(-6000, 460, 12000, 200),
]

spikes = []

# ゴール（旗っぽいもの）
goal = Rect(1700, 250, 26, 210)

# --- プレイヤ ---
player = Rect(-750, 200, 32, 42)
vx, vy = 0.0, 0.0
on_ground = False
coyote_timer = 0.0
jumpbuf_timer = 0.0
prev_jump = False

# float座標（当たり判定Rectに代入する前の“真の位置”）
px_f = float(player.x)
py_f = float(player.y)

camera_x = 0.0

# クリア状態
cleared = False

# --- スコア（B案: タイムボーナス） ---
GOAL_SCORE = 1000
TIME_BONUS_MAX = 3000
TIME_BONUS_PER_SEC = 100  # 1秒遅いごとに -100

clear_time = 0.0
score_total = 0
score_goal = 0
score_time_bonus = 0


def calc_time_bonus(time_sec: float) -> int:
    b = TIME_BONUS_MAX - int(time_sec * TIME_BONUS_PER_SEC)
    return b if b > 0 else 0


# --- プレイヤ画像（停止/移動/ジャンプ） ---
# collision.py と同じフォルダに以下を置いてください（透過PNG推奨）
#   player_idle.png
#   player_run.png
#   player_jump.png
try:
    img_idle = pygame.image.load("player_idle.png").convert_alpha()
    img_run = pygame.image.load("player_run.png").convert_alpha()
    img_jump = pygame.image.load("player_jump.png").convert_alpha()
except Exception as ex:
    raise SystemExit(
        "player_idle.png / player_run.png / player_jump.png が読み込めません。\n"
        "collision.py と同じフォルダに3つのPNGを置いてから起動してください。\n"
        f"詳細: {ex}"
    )

img_idle = pygame.transform.smoothscale(img_idle, (player.w, player.h))
img_run = pygame.transform.smoothscale(img_run, (player.w, player.h))
img_jump = pygame.transform.smoothscale(img_jump, (player.w, player.h))

facing_right = True

# ジャンプ画像が「接地/非接地」の判定揺れで点滅しないように、
# ジャンプ開始～着地までを明示的に管理するフラグ
is_jumping = False

def reset():
    global vx, vy, on_ground, coyote_timer, jumpbuf_timer, camera_x, cleared
    global clear_time, score_total, score_goal, score_time_bonus
    global facing_right
    global prev_jump, is_jumping
    global px_f, py_f
    player.x, player.y = -750, 200
    px_f = float(player.x)
    py_f = float(player.y)
    vx, vy = 0.0, 0.0
    on_ground = False
    coyote_timer = 0.0
    jumpbuf_timer = 0.0
    prev_jump = False
    camera_x = player.x - W * 0.35
    cleared = False
    clear_time = 0.0
    score_total = 0
    score_goal = 0
    score_time_bonus = 0
    facing_right = True
    is_jumping = False

def clamp(x, a, b):
    return a if x < a else b if x > b else x

def move_and_collide_player(dt):
    """プレイヤの軸分離衝突解決"""
    global vx, vy, on_ground, px_f, py_f
    on_ground = False

    # X
    px_f += vx * dt
    player.x = int(round(px_f))
    for s in solids:
        if player.colliderect(s):
            if vx > 0:
                player.right = s.left
            elif vx < 0:
                player.left = s.right
            vx = 0.0
            px_f = float(player.x)

    # Y
    py_f += vy * dt
    player.y = int(round(py_f))
    for s in solids:
        if player.colliderect(s):
            if vy > 0:
                player.bottom = s.top
                vy = 0.0
                on_ground = True
                py_f = float(player.y)
            elif vy < 0:
                player.top = s.bottom
                vy = 0.0
                py_f = float(player.y)



reset()

running = True
font = pygame.font.SysFont(None, 26)

while running:
    dt = min(0.02, clock.tick(60) / 1000.0)

    # NOTE: このファイルはトップレベルで変数を更新しているため global 宣言は不要

    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    if keys[pygame.K_r]:
        reset()

    if not cleared:
        # タイム計測
        clear_time += dt

        left  = keys[pygame.K_LEFT]
        right = keys[pygame.K_RIGHT]
        jump  = keys[pygame.K_UP]   # ジャンプは上矢印

        # ジャンプの「押した瞬間」だけ検出（押しっぱなしで状態が揺れにくくする）
        jump_pressed = jump and not prev_jump
        prev_jump = jump

        # 向き更新（入力があるときだけ更新）
        if left and not right:
            facing_right = False
        elif right and not left:
            facing_right = True

        # ジャンプバッファ
        if jump_pressed:
            jumpbuf_timer = JUMP_BUFFER
        else:
            jumpbuf_timer = max(0.0, jumpbuf_timer - dt)

        # コヨーテ
        if on_ground:
            coyote_timer = COYOTE
        else:
            coyote_timer = max(0.0, coyote_timer - dt)

        # 左右加速
        ax = MOVE_ACC if on_ground else AIR_ACC
        if left and not right:
            vx -= ax * dt
        if right and not left:
            vx += ax * dt

        # 摩擦（地上＆入力なし）
        if on_ground and not left and not right:
            if abs(vx) <= FRICTION * dt:
                vx = 0.0
            else:
                vx -= (FRICTION * dt) * (1 if vx > 0 else -1)

        vx = clamp(vx, -MAX_SPEED, MAX_SPEED)

        # 重力
        vy += G * dt

        # ジャンプ成立
        if jumpbuf_timer > 0.0 and coyote_timer > 0.0:
            vy = -JUMP_V
            jumpbuf_timer = 0.0
            coyote_timer = 0.0
            on_ground = False
            is_jumping = True

        # プレイヤ移動
        move_and_collide_player(dt)

        # 着地したらジャンプ状態を解除
        if on_ground:
            is_jumping = False

        # 落下死
        if player.y > 1200:
            reset()

        # トゲ
        for sp in spikes:
            if player.colliderect(sp):
                reset()

        # ゴール
        if player.colliderect(goal):
            cleared = True
            score_goal = GOAL_SCORE
            score_time_bonus = calc_time_bonus(clear_time)
            score_total = score_goal + score_time_bonus
            vx = 0.0
            vy = 0.0

        # カメラ
        target = player.x - W * 0.35
        camera_x += (target - camera_x) * min(1.0, 8.0 * dt)

    # --- 描画 ---
    screen.fill((27, 59, 122))
    pygame.draw.rect(screen, (30, 140, 200), Rect(0, 0, W, H))

    # 足場
    for s in solids:
        sx = s.x - int(camera_x)
        pygame.draw.rect(screen, (91, 58, 29), Rect(sx, s.y, s.w, s.h))
        pygame.draw.rect(screen, (122, 75, 34), Rect(sx, s.y, s.w, 6))

    # トゲ
    for sp in spikes:
        sx = sp.x - int(camera_x)
        pygame.draw.rect(screen, (196, 59, 59), Rect(sx, sp.y, sp.w, sp.h))

    # ゴール旗（棒 + 旗）
    gx = goal.x - int(camera_x)
    pygame.draw.rect(screen, (230, 230, 230), Rect(gx, goal.y, 6, goal.h))         # pole
    pygame.draw.rect(screen, (60, 240, 120), Rect(gx + 6, goal.y + 20, 40, 24))    # flag

    # プレイヤ
    px = player.x - int(camera_x)

    # 状態に応じて画像を切り替え
    if cleared:
        img = img_idle
    else:
        # is_jumping を優先することで、接地判定の揺れによる点滅を防ぐ
        if is_jumping:
            img = img_jump
        else:
            img = img_run if abs(vx) > 40.0 else img_idle

    if not facing_right:
        img = pygame.transform.flip(img, True, False)

    screen.blit(img, (px, player.y))

    # HUD
    hud = f"Move: LEFT/RIGHT   Jump: UP   R: reset   TIME: {clear_time:0.2f}s"
    msg = font.render(hud, True, (255, 255, 255))
    screen.blit(msg, (12, 12))

    if cleared:
        # 結果発表オーバーレイ
        overlay = pygame.Surface((W, H), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        screen.blit(overlay, (0, 0))

        title = pygame.font.SysFont(None, 44).render("RESULT", True, (255, 255, 255))
        screen.blit(title, (W // 2 - title.get_width() // 2, 90))

        lines = [
            f"TIME: {clear_time:0.2f}s",
            f"TIME BONUS: {score_time_bonus}",
            f"GOAL BONUS: {score_goal}",
            "------------------------",
            f"TOTAL SCORE: {score_total}",
            "",
            "Press R to restart",
        ]

        y = 160
        for line in lines:
            t = font.render(line, True, (255, 255, 255))
            screen.blit(t, (W // 2 - t.get_width() // 2, y))
            y += 30

    pygame.display.flip()

pygame.quit()
